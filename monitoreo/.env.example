# Copiar a .env y completar. El .env NO se sube a GitHub.

# Usuario administrador de Grafana (solo se aplica la primera vez que arranca).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar_esta_clave_grafana
# Dónde se publica Grafana. 127.0.0.1 = solo desde esta PC.
GRAFANA_BIND=127.0.0.1

# Credenciales de la base: las mismas del .env de la raíz del repo.
# (Pendiente: reemplazar por un usuario de solo lectura con rol pg_monitor.)
POSTGRES_USER=hoteles_app
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=hoteles

# Nombre de la red de la base y la API. Docker lo arma como
# <carpeta-del-repo>_red-hoteles. Verificar con: docker network ls
RED_HOTELES=bd-hoteles-tp_red-hoteles
