# Copiar este archivo como .env y completar los valores. El archivo .env NO se sube al repositorio.
# Para generar una contraseña larga: openssl rand -base64 24

NC_DB_NAME=nextcloud
NC_DB_USER=nextcloud
NC_DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA

NC_ADMIN_USER=ADMINC
NC_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LARGA

# Dominios desde los que se accede, separados por espacios (host.docker.internal permite que n8n suba informes).
NC_TRUSTED_DOMAINS=localhost host.docker.internal
# Puerto local donde se abre Nextcloud (http://localhost:8085)
NC_PORT=8085
