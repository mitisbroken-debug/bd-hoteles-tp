# Configuración de n8n (punto 13).
# 1) Ejecutar .\preparar.ps1 : copia este archivo a .env y genera solas las 4 claves internas.
# 2) Completar a mano en .env lo que dice "COMPLETAR".
# El archivo .env NO se sube a GitHub (está en .gitignore).

# ---------- n8n ----------
N8N_VERSION=2.45.7
N8N_PORT=5678

# ---------- Claves internas: las genera preparar.ps1, no hace falta inventarlas ----------
# Token entre n8n y su ejecutor de código.
N8N_RUNNERS_AUTH_TOKEN=
# Token que Alertmanager tiene que mandar para que n8n acepte la alerta.
WEBHOOK_TOKEN=
# Administrador de la base de verificación (no lo usa n8n).
VERIF_ADMIN_PASSWORD=
# Usuario limitado "n8n_flujos" con el que n8n entra a la base de verificación.
VERIF_N8N_PASSWORD=

# ---------- Monitoreo (punto 10) ----------
PROMETHEUS_URL=http://host.docker.internal:9090

# ---------- Backups (punto 4) ----------
# Carpeta donde db-backup deja los .dump, vista desde esta carpeta.
BACKUPS_DIR=../backups
# Un backup más viejo que esto se informa como error (el backup es cada 24 h).
BACKUP_MAX_HORAS=26
# Un backup más chico que esto se informa como error.
BACKUP_MIN_BYTES=1024

# ---------- Avisos por mail (Brevo) ---------- COMPLETAR
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# false = sin SSL directo (el puerto 587 usa STARTTLS).
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
# Remitente validado en Brevo y casilla que recibe los avisos.
MAIL_REMITENTE=
MAIL_DESTINO=

# ---------- IA para el informe de rendimiento (Gemini) ---------- COMPLETAR
GEMINI_API_KEY=
# gemini-flash-latest existe pero tardaba más de 60 s; este responde en ~2 s.
GEMINI_MODELO=gemini-3.1-flash-lite

# ---------- Mantis (punto 11, carpeta mantis/) ---------- COMPLETAR
# Si queda vacío, las incidencias se guardan en la tabla local y se avisa por mail.
# Mantis publica el puerto 9081: http://host.docker.internal:9081
MANTIS_URL=
# Token de API de un usuario que solo reporta (Mi cuenta > Tokens de API).
MANTIS_TOKEN=
MANTIS_PROYECTO=BD Hoteles TP
MANTIS_CATEGORIA=Infraestructura

# ---------- Nextcloud (punto 12, carpeta nextcloud/) ---------- COMPLETAR
# Si queda vacío, los informes se guardan en la tabla local y se mandan por mail.
# Nextcloud publica el puerto 8085: http://host.docker.internal:8085
# Ojo: en el .env de Nextcloud, NC_TRUSTED_DOMAINS tiene que incluir host.docker.internal.
NEXTCLOUD_URL=
NEXTCLOUD_USUARIO=
# Contraseña de aplicación de ese usuario (no la clave principal).
NEXTCLOUD_PASSWORD=
NEXTCLOUD_CARPETA=08_Automatizacion_n8n
