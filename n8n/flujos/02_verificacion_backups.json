    {
      "parameters": {
        "fromEmail": "={{ $('Configuración').first().json.mailRemitente }}",
        "toEmail": "={{ $('Configuración').first().json.mailDestino }}",
        "subject": "=[Hoteles] ERROR en el backup: {{ $json.estado }}",
        "emailFormat": "html",
        "html": "=<h2 style=\"color:#b00020\">El backup de la base de hoteles tiene un problema</h2>\n<p><b>{{ $json.detalle }}</b></p>\n<ul>\n<li>Estado: {{ $json.estado }}</li>\n<li>Archivo: {{ $json.archivo || 'ninguno' }}</li>\n<li>Tamaño: {{ $json.bytes || 0 }} bytes</li>\n<li>Antigüedad: {{ $json.antiguedad_horas || '-' }} h</li>\n<li>Verificación n.º {{ $json.id }}</li>\n</ul>\n<p>Qué revisar: <code>docker logs db-backup</code> y la carpeta <code>backups/</code>.</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "5287965a-6912-5e6c-85a7-2de9b23d30bf",
      "name": "Avisar error de backup",
