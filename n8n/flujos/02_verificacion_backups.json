    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (SELECT $1::jsonb AS x),\n     e AS (INSERT INTO errores_flujos (flujo, tarea, detalle, ejecucion_n8n)\n           SELECT 'Verificación de backups', 'Pedir aprobación para restaurar', left(x->>'detalle', 1000), x->>'ejecucion' FROM s)\nUPDATE verificaciones_backup v\n   SET aprobacion = 'sin_respuesta',\n       detalle = v.detalle || ' | No se pudo enviar el pedido de aprobación: no se restauró.'\n  FROM s\n WHERE v.id = (s.x->>'id')::bigint\nRETURNING v.*;",
        "options": {
          "queryReplacement": "={{ JSON.stringify({ id: $('Guardar verificación').first().json.id, detalle: ($json.error && $json.error.message) || $json.error || 'sin detalle', ejecucion: $execution.id }) }}"
        }
