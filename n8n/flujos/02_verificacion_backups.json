    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE verificaciones_backup v\n   SET aprobacion = CASE WHEN $2 = 'rechazar' THEN 'rechazada' ELSE 'sin_respuesta' END,\n       detalle = v.detalle || CASE WHEN $2 = 'rechazar' THEN ' | Restauración rechazada por el operador.'\n                                   ELSE ' | Nadie respondió en 30 minutos: no se restauró.' END\n WHERE v.id = $1::bigint\nRETURNING v.*;",
        "options": {
          "queryReplacement": "={{ [ $('Guardar verificación').first().json.id, String(($json.query || {}).decision || 'ninguna') ] }}"
        }
      },
      "id": "8a68b939-ebe6-5393-b8f4-6bfc9cc98f8e",
      "name": "Guardar que no se aprobó",
      "type": "n8n-nodes-base.postgres",
