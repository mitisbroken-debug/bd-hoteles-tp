      "id": "67b3ec7a-98e8-5ed4-9648-37ba28028a97",
      "name": "Restaurar en la base de prueba",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1980,
        20
      ],
      "credentials": {
        "postgres": {
          "id": "hiaPostgresControl",
          "name": "Postgres de control (n8n_flujos)"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE verificaciones_backup v\n   SET aprobacion = 'aprobada',\n       restauracion = CASE WHEN (s.x->>'ok')::boolean THEN 'ok' ELSE 'error' END,\n       tablas_restauradas = (s.x->>'tablas')::integer,\n       filas_reserva = (s.x->>'filas_reserva')::bigint,\n       duracion_seg = (s.x->>'segundos')::numeric,\n       detalle = v.detalle || ' | ' || COALESCE(s.x->>'detalle', '')\n  FROM (SELECT $1::jsonb AS x) s\n WHERE v.id = (s.x->>'id')::bigint\nRETURNING v.*;",
        "options": {
          "queryReplacement": "={{ JSON.stringify({ id: $('Guardar verificación').first().json.id, ok: $json.ok, tablas: $json.tablas, filas_reserva: $json.filas_reserva, segundos: $json.segundos, detalle: $json.detalle }) }}"
        }
      },
      "id": "d04e470c-428f-52b4-87d5-7cfda5a02d69",
      "name": "Guardar resultado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2200,
        -60
      ],
      "credentials": {
        "postgres": {
          "id": "hiaPostgresControl",
          "name": "Postgres de control (n8n_flujos)"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH s AS (SELECT $1::jsonb AS x),\n     e AS (INSERT INTO errores_flujos (flujo, tarea, detalle, ejecucion_n8n)\n           SELECT 'Verificación de backups', 'Restaurar en la base de prueba', left(x->>'detalle', 1000), x->>'ejecucion' FROM s)\nUPDATE verificaciones_backup v\n   SET aprobacion = 'aprobada', restauracion = 'error',\n       detalle = v.detalle || ' | La restauración falló: ' || left(COALESCE(s.x->>'detalle', ''), 300)\n  FROM s\n WHERE v.id = (s.x->>'id')::bigint\nRETURNING v.*;",
        "options": {
          "queryReplacement": "={{ JSON.stringify({ id: $('Guardar verificación').first().json.id, detalle: ($json.error && $json.error.message) || $json.error || 'sin detalle', ejecucion: $execution.id }) }}"
        }
