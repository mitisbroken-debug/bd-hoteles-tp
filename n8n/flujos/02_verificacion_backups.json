      "id": "69b066e9-b31e-5793-9926-b1d9c70b54a7",
      "name": "Buscar y revisar el último backup",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "hiaPostgresControl",
          "name": "Postgres de control (n8n_flujos)"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Decide si el último backup sirve. Cuatro controles: existe, se puede leer,\n// no está vacío y no es viejo (el servicio db-backup hace una copia cada 24 h).\nconst cfg = $('Configuración').first().json;\nconst b = $input.first().json;\n\nconst maxHoras = Number(cfg.maxHoras) || 26;\nconst minBytes = Number(cfg.minBytes) || 1024;\nconst bytes = b.bytes == null ? null : Number(b.bytes);\nconst horas = b.antiguedad_horas == null ? null : Number(b.antiguedad_horas);\n\nlet estado = 'ok';\nlet detalle = '';\nif (!b.archivo) {\n  estado = 'sin_backup';\n  detalle = 'No hay ningún backup en la carpeta.';\n} else if (b.legible !== true) {\n  estado = 'ilegible';\n  detalle = 'pg_restore no pudo leer el archivo: ' + (b.detalle || 'sin detalle');\n} else if (bytes < minBytes) {\n  estado = 'chico';\n  detalle = 'El archivo pesa ' + bytes + ' bytes y el mínimo aceptado es ' + minBytes + '.';\n} else if (horas > maxHoras) {\n  estado = 'viejo';\n  detalle = 'El último backup tiene ' + horas + ' h y el máximo aceptado es ' + maxHoras\n          + ' h: el servicio de backup no está generando copias nuevas.';\n} else {\n  detalle = 'Archivo correcto: ' + b.objetos + ' objetos, ' + bytes + ' bytes, ' + horas + ' h de antigüedad.';\n}\n\nreturn [{\n  json: {\n    paraBase: JSON.stringify({\n      archivo: b.archivo || null,\n      bytes,\n      modificado: b.modificado || null,\n      antiguedad_horas: horas,\n      legible: b.legible === true,\n      objetos: b.objetos == null ? null : Number(b.objetos),\n      estado,\n      detalle,\n      // La restauración es una acción delicada: solo se hace si una persona la aprueba.\n      aprobacion: estado === 'ok' ? 'pendiente' : 'no_corresponde',\n      ejecucion_n8n: $execution.id,\n    }),\n  },\n}];\n"
      },
      "id": "2e411a4d-14dd-56b4-be2c-17a120f5f0ee",
      "name": "Evaluar backup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO verificaciones_backup\n       (archivo, bytes, modificado, antiguedad_horas, legible, objetos, estado, detalle, aprobacion, ejecucion_n8n)\nSELECT r.archivo, r.bytes, r.modificado, r.antiguedad_horas, r.legible, r.objetos, r.estado, r.detalle,\n       r.aprobacion, r.ejecucion_n8n\n  FROM jsonb_populate_record(NULL::verificaciones_backup, $1::jsonb) r\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ $json.paraBase }}"
        }
      },
      "id": "bb03932a-012e-5e5a-9657-c435a0dc1f87",
      "name": "Guardar verificación",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        880,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "hiaPostgresControl",
          "name": "Postgres de control (n8n_flujos)"
        }
