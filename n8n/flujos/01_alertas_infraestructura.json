    {
      "parameters": {
        "jsCode": "// Valida lo que mandó Alertmanager y calcula la prioridad de cada alerta.\n// Prioridad = impacto + urgencia (como en la unidad de Gestión de Incidentes).\nconst cuerpo = $input.first().json.body;\nconst ejecucion = $execution.id;\n\n// Impacto: a cuánta gente o a qué parte del negocio afecta.\nconst IMPACTO_ALTO = ['ApiCaida', 'BasePrincipalCaida'];          // el usuario no puede reservar\nconst IMPACTO_MEDIO = ['ReplicaCaida', 'ReplicaDesconectada', 'ContenedorSinReportar',\n                       'ConexionesAltas', 'DiscoCasiLleno'];      // el sistema anda, pero degradado o en riesgo\n// Urgencia: la da la severidad que definimos en las reglas de Prometheus.\nconst URGENCIA = { critical: 'alta', warning: 'media', info: 'baja' };\nconst MATRIZ = {\n  alto:  { alta: 'urgente', media: 'alta',   baja: 'normal' },\n  medio: { alta: 'alta',    media: 'normal', baja: 'baja' },\n  bajo:  { alta: 'normal',  media: 'baja',   baja: 'baja' },\n};\n\nfunction limpiar(v, max) {\n  if (typeof v !== 'string') return '';\n  return v.replace(/[\\u0000-\\u001f\\u007f]/g, ' ').trim().slice(0, max);\n}\nfunction fecha(v) {\n  if (typeof v !== 'string') return null;\n  const d = new Date(v);\n  if (isNaN(d.getTime()) || d.getUTCFullYear() < 2000) return null;\n  return d.toISOString();\n}\nfunction invalido(motivo) {\n  return { json: { valido: false, motivo } };\n}\n\n// 1) ¿Tiene la forma de un aviso de Alertmanager?\nif (!cuerpo || typeof cuerpo !== 'object' || !Array.isArray(cuerpo.alerts)) {\n  return [invalido('El pedido no trae la lista \"alerts\" de Alertmanager')];\n}\nif (cuerpo.alerts.length === 0 || cuerpo.alerts.length > 50) {\n  return [invalido('Cantidad de alertas no permitida: ' + cuerpo.alerts.length)];\n}\n\n// 2) Revisar alerta por alerta. Solo pasan nombres y estados conocidos; los textos se recortan.\nconst salida = [];\nfor (const a of cuerpo.alerts) {\n  const etiquetas = (a && typeof a.labels === 'object' && a.labels) || {};\n  const notas = (a && typeof a.annotations === 'object' && a.annotations) || {};\n  const nombre = etiquetas.alertname;\n\n  if (typeof nombre !== 'string' || !/^[A-Za-z][A-Za-z0-9_]{0,63}$/.test(nombre)) {\n    salida.push(invalido('Nombre de alerta ausente o con caracteres no permitidos'));\n    continue;\n  }\n  if (a.status !== 'firing' && a.status !== 'resolved') {\n    salida.push(invalido('Estado de alerta desconocido en ' + nombre));\n    continue;\n  }\n\n  const instancia = limpiar(etiquetas.instance || etiquetas.name || '', 200);\n  const severidad = URGENCIA[etiquetas.severity] ? etiquetas.severity : 'info';\n  const impacto = IMPACTO_ALTO.includes(nombre) ? 'alto' : IMPACTO_MEDIO.includes(nombre) ? 'medio' : 'bajo';\n  const urgencia = URGENCIA[severidad];\n\n  salida.push({\n    json: {\n      valido: true,\n      alerta: {\n        huella: nombre + '|' + instancia,   // mismo problema = misma alerta en la misma instancia\n        alerta: nombre,\n        instancia,\n        estado: a.status,\n        severidad,\n        impacto,\n        urgencia,\n        prioridad: MATRIZ[impacto][urgencia],\n        resumen: limpiar(notas.summary, 200) || nombre,\n        descripcion: limpiar(notas.description, 1000),\n        inicio: fecha(a.startsAt),\n        fin: a.status === 'resolved' ? fecha(a.endsAt) : null,\n        ejecucion,\n      },\n    },\n  });\n}\nreturn salida;\n"
      },
